# --- Server ---
PORT=8787

# --- Lightning feed ---
# simulator: synthetic moving storm cells (default; runs anywhere, no creds)
# blitzortung: experimental adapter for the Blitzortung community WebSocket
FEED=simulator

# How long strikes are retained / served (minutes)
STRIKE_TTL_MIN=60

# --- Alerting ---
# Min gap between alerts for the same device+place in "every" mode (seconds)
ALERT_COOLDOWN_SEC=120
# In "first" mode, silence window after the first strike of a storm (minutes)
STORM_WINDOW_MIN=30

# --- APNs (optional; pushes are no-ops until all four are set) ---
# Path to the .p8 token-auth key downloaded from the Apple Developer portal
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# Your app's bundle id, e.g. com.example.LightningTracker
APNS_TOPIC=
# true => api.push.apple.com, false => api.sandbox.push.apple.com
APNS_PRODUCTION=false
